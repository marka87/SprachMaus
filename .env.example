# Nur für die Entwicklung: wird beim ersten Start nach %APPDATA%\SprachMaus\settings.env übernommen.
# Normal stellt man alles im Tray-Menü unter "Einstellungen" ein.
# Gemini API Key (kostenlos erstellbar unter: https://aistudio.google.com/apikey)
GEMINI_API_KEY=dein_api_schluessel_hier

# Tastaturkürzel zum Aktivieren (Standard: <ctrl>+<alt>+s, wird von Windows abgefangen und erreicht kein anderes Programm)
# Alternativen z. B.: <ctrl>+<shift>+<f12> oder <pause>
HOTKEY=<ctrl>+<alt>+s

# Modell (gemini-3.5-flash-lite ist ultraschnell < 1 Sekunde & immer verfuegbar)
GEMINI_MODEL=gemini-3.5-flash-lite

